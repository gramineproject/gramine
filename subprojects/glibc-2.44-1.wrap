# NOTE: We use a custom version number (the `-1` suffix) to force Meson to rebuild when there is a
# breaking change to the interface between Glibc and Gramine. The important part is that the
# directory in `subprojects` has to change (`subprojects/glibc-2.44-1`, `subprojects/glibc-2.44-2`
# etc.)

[wrap-file]
directory = glibc-2.44-1
source_url = https://ftp.gnu.org/gnu/glibc/glibc-2.44.tar.gz
source_fallback_url = https://packages.gramineproject.io/distfiles/glibc-2.44.tar.gz
source_filename = glibc-2.44.tar.gz
source_hash = 1217fc41ac7fb1f310c8c32b9c6c009cc769398d4b367b6aa57be0bb3ea8c1ef
patch_directory = glibc-2.44

# this unpacks the sources to `glibc-2.44-1/glibc-2.44`
lead_directory_missing = true
